{
  "expo": {
    "name": "Shoe Tracker 10000",
    "slug": "ShoeTrackerHealth",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-2.0.png",
    "scheme": "shoetrackerhealth",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.caddy515.ShoeTrackerHealth",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "CFBundleDisplayName": "Shoe Tracker 10000",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Shoe Tracker 10000 uses the camera only when you choose to take a photo of a running shoe, for example to show that shoe on its detail card and mileage tracker.",
        "NSHealthShareUsageDescription": "We need access to your health data to track running workouts",
        "NSHealthUpdateUsageDescription": "We need permission to read your running workouts from Apple Health",
        "NSPhotoLibraryUsageDescription": "Shoe Tracker 10000 uses your photo library only when you choose a shoe photo, for example to display that shoe in your active and retired shoe lists."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.caddy515.ShoeTrackerHealth"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon-2.0.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "entitlements": {
              "com.apple.developer.healthkit": true
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f259adf-1935-4d40-9f95-b20a5704169c"
      }
    }
  }
}
